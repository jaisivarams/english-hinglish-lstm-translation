        "from tensorflow.keras.layers import Dropout\n",
        "EMB, UNITS = 128, 256\n",
        "\n",
        "# Encoder\n",
        "enc_inputs = Input(shape=(MAX_SRC,), name=\"enc_in\")\n",
        "enc_emb_layer = Embedding(EN_V, EMB, mask_zero=True, name=\"enc_emb\")\n",
        "enc_drop = Dropout(0.3)\n",
        "enc_lstm = LSTM(UNITS, return_state=True, name=\"enc_lstm\")\n",
        "_, state_h, state_c = enc_lstm(enc_drop(enc_emb_layer(enc_inputs)))\n",
        "\n",
        "# Decoder (initialised with encoder states)\n",
        "dec_inputs = Input(shape=(None,), name=\"dec_in\")\n",
        "dec_emb_layer = Embedding(HI_V, EMB, mask_zero=True, name=\"dec_emb\")\n",
        "dec_drop = Dropout(0.3)\n",
        "dec_lstm = LSTM(UNITS, return_sequences=True, return_state=True, name=\"dec_lstm\")\n",
        "dec_out_drop = Dropout(0.3)\n",
        "dec_dense = Dense(HI_V, activation=\"softmax\", name=\"out\")\n",
        "dec_seq, _, _ = dec_lstm(dec_drop(dec_emb_layer(dec_inputs)), initial_state=[state_h, state_c])\n",
        "outputs = dec_dense(dec_out_drop(dec_seq))\n",
        "\n",
        "model = Model([enc_inputs, dec_inputs], outputs)\n",
        "model.compile(optimizer=tf.keras.optimizers.Adam(1e-3),\n",
        "              loss=\"sparse_categorical_crossentropy\", metrics=[\"accuracy\"])\n",
        "model.summary()"
