        "import os, re, glob, random\n",
        "import numpy as np, pandas as pd\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.preprocessing.text import Tokenizer\n",
        "from tensorflow.keras.preprocessing.sequence import pad_sequences\n",
        "from tensorflow.keras.layers import Input, Embedding, LSTM, Dense, Dropout\n",
        "from tensorflow.keras.models import Model\n",
        "\n",
        "SEED = 42\n",
        "random.seed(SEED); np.random.seed(SEED); tf.random.set_seed(SEED)\n",
        "print(\"GPU:\", tf.config.list_physical_devices(\"GPU\"))\n",
        "\n",
        "# ---- Load ----\n",
        "def load(fn):\n",
        "    rows = []\n",
        "    with open(fn, encoding=\"utf-8\") as f:\n",
        "        for line in f:\n",
        "            line = line.rstrip(\"\\n\")\n",
        "            if line.count(\"\\t\") == 1:\n",
        "                en, hi = line.split(\"\\t\")\n",
        "                if en.strip() and hi.strip():\n",
        "                    rows.append((en, hi))\n",
        "    return pd.DataFrame(rows, columns=[\"en\", \"hi\"])\n",
        "\n",
        "train_df, dev_df, test_df = load(\"train.txt\"), load(\"dev.txt\"), load(\"test.txt\")\n",
        "print(\"raw:\", len(train_df), len(dev_df), len(test_df))\n",
        "\n",
        "# ---- Preprocess ----\n",
        "def clean(s):\n",
        "    s = str(s).lower().strip()\n",
        "    s = re.sub(r\"([?.!,;:।])\", r\" \\1 \", s)\n",
        "    s = re.sub(r\"[^\\w\\s\\u0900-\\u097F?.!,;:।']\", \" \", s)\n",
        "    return re.sub(r\"\\s+\", \" \", s).strip()\n",
        "\n",
        "MAX_LEN = 20\n",
        "def prep(df):\n",
        "    df = df.copy()\n",
        "    df[\"en\"] = df[\"en\"].map(clean); df[\"hi\"] = df[\"hi\"].map(clean)\n",
        "    ok = df.en.str.split().str.len().between(1, MAX_LEN) & df.hi.str.split().str.len().between(1, MAX_LEN)\n",
        "    return df[ok].reset_index(drop=True)\n",
        "\n",
        "train_df, dev_df, test_df = prep(train_df), prep(dev_df), prep(test_df)\n",
        "print(\"after filtering:\", len(train_df), len(dev_df), len(test_df))\n",
        "\n",
        "# ---- Tokenize + pad ----\n",
        "VOCAB = 8000\n",
        "for d in (train_df, dev_df, test_df):\n",
        "    d[\"hi_in\"] = \"<sos> \" + d[\"hi\"] + \" <eos>\"\n",
        "\n",
        "en_tok = Tokenizer(num_words=VOCAB, oov_token=\"<unk>\", filters=\"\")\n",
        "hi_tok = Tokenizer(num_words=VOCAB, oov_token=\"<unk>\", filters=\"\")\n",
        "en_tok.fit_on_texts(train_df[\"en\"]); hi_tok.fit_on_texts(train_df[\"hi_in\"])\n",
        "EN_V = min(VOCAB, len(en_tok.word_index) + 1)\n",
        "HI_V = min(VOCAB, len(hi_tok.word_index) + 1)\n",
        "print(\"English vocab:\", EN_V, \"| Hinglish vocab:\", HI_V)\n",
        "\n",
        "MAX_SRC, MAX_TGT = MAX_LEN, MAX_LEN + 2\n",
        "def encode(df):\n",
        "    X = pad_sequences(en_tok.texts_to_sequences(df[\"en\"]), maxlen=MAX_SRC, padding=\"post\")\n",
        "    Y = pad_sequences(hi_tok.texts_to_sequences(df[\"hi_in\"]), maxlen=MAX_TGT, padding=\"post\")\n",
        "    return X, Y[:, :-1], Y[:, 1:]\n",
        "\n",
        "X_tr, din_tr, dout_tr = encode(train_df)\n",
        "X_va, din_va, dout_va = encode(dev_df)\n",
        "X_te, din_te, dout_te = encode(test_df)\n",
        "print(X_tr.shape, din_tr.shape, dout_tr.shape)\n",
        "train_df[[\"en\", \"hi\"]].sample(5, random_state=1)"
