        "from google.colab import files\n",
        "uploaded = files.upload()   # select train.txt, dev.txt, test.txt together\n",
        "\n",
        "def load(fn):\n",
        "    rows = []\n",
        "    with open(fn, encoding=\"utf-8\") as f:\n",
        "        for line in f:\n",
        "            line = line.rstrip(\"\\n\")\n",
        "            if line.count(\"\\t\") == 1:\n",
        "                en, hi = line.split(\"\\t\")\n",
        "                if en.strip() and hi.strip():\n",
        "                    rows.append((en, hi))\n",
        "    return pd.DataFrame(rows, columns=[\"en\", \"hi\"])\n",
        "\n",
        "train_df, dev_df, test_df = load(\"train.txt\"), load(\"dev.txt\"), load(\"test.txt\")\n",
