        "    h, c = encoder_model.predict(seqs, verbose=0)\n",
        "    B = len(seqs)\n",
        "    tgt = np.full((B, 1), sos_id)\n",
        "    out = [[] for _ in range(B)]\n",
        "    done = np.zeros(B, dtype=bool)\n",
        "    for _ in range(MAX_TGT):\n",
        "        probs, h, c = decoder_model.predict([tgt, h, c], verbose=0)\n",
        "        nxt = probs[:, -1, :].argmax(-1)\n",
        "        for i, t in enumerate(nxt):\n",
        "            if done[i]: continue\n",
