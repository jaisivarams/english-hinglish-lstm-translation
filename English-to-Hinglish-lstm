        "def clean(s):\n",
        "    s = str(s).lower().strip()\n",
        "    s = re.sub(r\"([?.!,;:।])\", r\" \\1 \", s)                # separate punctuation\n",
        "    s = re.sub(r\"[^\\w\\s\\u0900-\\u097F?.!,;:।']\", \" \", s)   # keep Devanagari + punctuation\n",
        "    return re.sub(r\"\\s+\", \" \", s).strip()\n",
        "\n",
        "MAX_LEN = 30   # max words per sentence\n",
        "\n",
        "def prep(df):\n",
        "    df = df.copy()\n",
        "    df[\"en\"] = df[\"en\"].map(clean)\n",
        "    df[\"hi\"] = df[\"hi\"].map(clean)\n",
        "    ok = df.en.str.split().str.len().between(1, MAX_LEN) & df.hi.str.split().str.len().between(1, MAX_LEN)\n",
        "    return df[ok].reset_index(drop=True)\n",
        "\n",
        "train_df, dev_df, test_df = prep(train_df), prep(dev_df), prep(test_df)\n",
        "print(\"after filtering:\", len(train_df), len(dev_df), len(test_df))\n",
        "train_df.sample(5, random_state=1)"
